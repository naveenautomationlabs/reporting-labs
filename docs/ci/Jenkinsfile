// Sample declarative Jenkins pipeline for a project that uses reportingLabs.
pipeline {
  agent any
  options { timestamps() }
  stages {
    stage('Install') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install --with-deps'
      }
    }
    stage('Test') {
      steps {
        // The history file lives in the workspace. Jenkins keeps the workspace
        // between builds on the same agent, so the trend builds up on its own.
        // If you call cleanWs() or use ephemeral agents, stash/unstash or
        // archive reporting-labs.history.json and restore it before this step.
        sh 'npx playwright test'
      }
    }
  }
  post {
    always {
      // Report + assets. reportingLabs labels the run with BUILD_NUMBER and
      // links this job in the Environment card automatically.
      archiveArtifacts artifacts: 'reporting-labs/**', allowEmptyArchive: true

      // Optional: show it inside Jenkins with the HTML Publisher plugin.
      // Jenkins' default Content-Security-Policy blocks the inline JavaScript
      // that single-file reports rely on, so the page shows up blank until an
      // admin relaxes it in the script console:
      //   System.setProperty("hudson.model.DirectoryBrowserSupport.CSP", "")
      // publishHTML(target: [reportDir: 'reporting-labs', reportFiles: 'index.html', reportName: 'Test report', keepAll: true])
    }

    // Optional: Slack notification with the Slack Notification plugin.
    failure {
      slackSend(
        color: 'danger',
        channel: '#qa-reports',
        message: "Playwright FAILED on ${env.BRANCH_NAME ?: env.JOB_NAME} #${env.BUILD_NUMBER}\nReport: ${env.BUILD_URL}artifact/reporting-labs/index.html"
      )
    }

    // Optional: email the report as an attachment with the Email Extension plugin.
    // unsuccessful {
    //   emailext(
    //     subject: "Playwright FAILED on ${env.JOB_NAME} #${env.BUILD_NUMBER}",
    //     body: "See attached report or open: ${env.BUILD_URL}artifact/reporting-labs/index.html",
    //     to: 'qa-leads@acme.com',
    //     attachmentsPattern: 'reporting-labs/index.html'
    //   )
    // }
  }
}
